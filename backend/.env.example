DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/autointellect
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=replace-me-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Ставка нормо-часа в рублях (используется при расчёте стоимости ремонта)
LABOR_RATE_PER_HOUR=2000
# Расходы на владение авто в год — доля цены авто (0.08 = 8%), для сценария «ремонт -> эксплуатация»
ANNUAL_RUNNING_COSTS_RATE=0.08
# JSON-список разрешённых origin'ов фронтенда
CORS_ORIGINS=["http://localhost:3000"]
# Папка для файлов чеков (по умолчанию backend/uploads)
UPLOAD_DIR=uploads
